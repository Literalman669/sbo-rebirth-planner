{
  "name": "@sbo/optimizer-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "spacetimedb"],
  "scripts": {
    "postinstall": "npm ci --prefix spacetimedb --workspaces=false --ignore-scripts",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "npm run dev --workspace @sbo/optimizer-client",
    "build": "npm run build --workspace @sbo/optimizer-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @sbo/optimizer-client"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  }
}
