{
  "name": "@sbo/optimizer-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "spacetimedb"
  ],
  "scripts": {
    "postinstall": "npm ci --prefix spacetimedb --workspaces=false --ignore-scripts",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "npm run dev --workspace @sbo/optimizer-client",
    "build": "npm run build --workspace @sbo/optimizer-client",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present && node --test scripts/*.test.mjs && npm run test:wiki-tools",
    "test:e2e": "npm run test:e2e --workspace @sbo/optimizer-client",
    "test:stress": "npm run test:unit --workspace @sbo/optimizer-client -- --run optimizerStress.test.ts",
    "test:reliability": "node scripts/run-reliability.mjs",
    "test:integration": "node scripts/run-local-integration.mjs",
    "test:pages": "npm run build:pages && npm run test:pages --workspace @sbo/optimizer-client",
    "validate:coverage": "node scripts/validate-release-coverage.mjs client/src/data/fallback-release.json",
    "export:fallback": "tsx scripts/export-fallback-release.mjs",
    "build:fallback:local": "node scripts/build-local-fallback.mjs",
    "audit:wiki-inventory": "tsx scripts/wiki/inventory.mjs",
    "audit:wiki": "tsx scripts/audit-wiki-catalog.mjs",
    "test:wiki-tools": "node --import tsx --test scripts/wiki/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
